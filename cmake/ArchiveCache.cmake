function(rym_cached_archive result name url hash extension)
  file(MAKE_DIRECTORY "${RYM_DOWNLOADS}")
  set(archive "${RYM_DOWNLOADS}/${name}-${hash}.${extension}")
  file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 300)
  if(EXISTS "${archive}")
    file(SHA256 "${archive}" actual)
    if(NOT actual STREQUAL hash)
      message(FATAL_ERROR "Cached archive has an invalid SHA-256: ${archive}. Remove it and configure again.")
    endif()
  else()
    file(GLOB previous_archives "${CMAKE_SOURCE_DIR}/build/*/_deps/${name}-tmp/${name}.${extension}")
    list(PREPEND previous_archives "${RYM_DOWNLOADS}/${name}.${extension}"
      "${CMAKE_BINARY_DIR}/_deps/${name}-tmp/${name}.${extension}")
    foreach(previous IN LISTS previous_archives)
      if(EXISTS "${previous}")
        file(SHA256 "${previous}" actual)
        if(actual STREQUAL hash)
          file(COPY_FILE "${previous}" "${archive}")
          break()
        endif()
      endif()
    endforeach()
    if(NOT EXISTS "${archive}")
      message(STATUS "Downloading ${name} to the dependency archive cache")
      set(temporary "${archive}.part")
      file(DOWNLOAD "${url}" "${temporary}" TLS_VERIFY ON TIMEOUT 300
        INACTIVITY_TIMEOUT 60 STATUS status)
      list(GET status 0 code)
      if(NOT code EQUAL 0)
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Cannot download ${name}: ${status}")
      endif()
      file(SHA256 "${temporary}" actual)
      if(NOT actual STREQUAL hash)
        file(REMOVE "${temporary}")
        message(FATAL_ERROR "Downloaded ${name} has an invalid SHA-256.")
      endif()
      file(RENAME "${temporary}" "${archive}")
    endif()
  endif()
  set(${result} "${archive}" PARENT_SCOPE)
endfunction()
